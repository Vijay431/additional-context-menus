    "configuration": {
      "title": "Additional Context Menus",
      "properties": {
        "additionalContextMenus.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Additional Context Menus extension",
          "markdownDescription": "Enable or disable the **Additional Context Menus** extension.\n\n**Example:** Set to `false` to temporarily hide all context menu items without uninstalling the extension."
        },
        "additionalContextMenus.autoDetectProjects": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect frameworks for informational purposes",
          "markdownDescription": "Automatically detect Node.js frameworks (React, Angular, Express, Next.js) in the workspace for informational purposes.\n\n**Example:** When `true`, the extension identifies your framework and tailors context menu labels accordingly."
        },
        "additionalContextMenus.supportedExtensions": {
          "type": "array",
          "default": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx"
          ],
          "description": "File extensions where context menus will be shown",
          "markdownDescription": "List of file extensions for which context menu items are displayed.\n\n**Default:** `[\".ts\", \".tsx\", \".js\", \".jsx\"]`\n\n**Example:** Add `\".mts\"` or `\".cts\"` to support additional TypeScript module formats."
        },
        "additionalContextMenus.copyCode.insertionPoint": {
          "type": "string",
          "enum": [
            "smart",
            "end",
            "beginning"
          ],
          "default": "smart",
          "description": "Where to insert copied code in target file",
          "markdownDescription": "Controls where copied code is inserted in the target file.\n\n- `smart` *(default)* — inserts after the last import statement, before the first export, or at the end\n- `end` — always appends to the bottom of the file\n- `beginning` — always inserts at the top of the file\n\n**Example:** Use `\"end\"` if you prefer all pasted code to appear at the bottom of the target file."
        },
        "additionalContextMenus.copyCode.preserveComments": {
          "type": "boolean",
          "default": true,
          "description": "Preserve comments when copying code",
          "markdownDescription": "When `true`, JSDoc and inline comments are included when copying or moving code.\n\n**Example:** Set to `false` to strip all comments from copied code for a cleaner paste."
        },
        "additionalContextMenus.saveAll.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show notification after saving all files",
          "markdownDescription": "When `true`, a notification is shown in the bottom-right corner after the **Save All** command completes.\n\n**Example:** Set to `false` for a silent save-all experience."
        },
        "additionalContextMenus.saveAll.skipReadOnly": {
          "type": "boolean",
          "default": true,
          "description": "Skip read-only files when saving all",
          "markdownDescription": "When `true`, read-only files are silently skipped during **Save All** instead of triggering an error.\n\n**Example:** Set to `false` if you want to be notified when a read-only file cannot be saved."
        },
        "additionalContextMenus.terminal.type": {
          "type": "string",
          "enum": [
            "integrated",
            "external",
            "system-default"
          ],
          "default": "integrated",
          "description": "Type of terminal to open when using 'Open in Terminal' command",
          "markdownDescription": "Selects which terminal is opened by the **Open in Terminal** command.\n\n- `integrated` *(default)* — opens VS Code's built-in terminal panel\n- `external` — launches the terminal defined in `#additionalContextMenus.terminal.externalTerminalCommand#`\n- `system-default` — uses the OS default terminal application\n\n**Example:** Use `\"external\"` with `externalTerminalCommand` set to `\"wt -d {{directory}}\"` to open Windows Terminal."
        },
        "additionalContextMenus.terminal.externalTerminalCommand": {
          "type": "string",
          "default": "",
          "description": "Custom command for external terminal. Use {{directory}} as placeholder for directory path",
          "markdownDescription": "Custom shell command used when `#additionalContextMenus.terminal.type#` is set to `external`.\n\nUse `{{directory}}` as a placeholder for the target directory path.\n\n**Examples:**\n- macOS iTerm2: `open -a iTerm {{directory}}`\n- Windows Terminal: `wt -d {{directory}}`\n- GNOME Terminal: `gnome-terminal --working-directory={{directory}}`"
        },
        "additionalContextMenus.terminal.openBehavior": {
          "type": "string",
          "enum": [
            "parent-directory",
            "workspace-root",
            "current-directory"
          ],
          "default": "parent-directory",
          "description": "Which directory to open in terminal",
          "markdownDescription": "Determines the working directory used when opening a terminal.\n\n- `parent-directory` *(default)* — opens the folder containing the right-clicked file\n- `workspace-root` — always opens the workspace root folder\n- `current-directory` — opens the directory of the currently active editor\n\n**Example:** Use `\"workspace-root\"` to always start terminals at the project root regardless of which file you right-clicked."
        },
        "additionalContextMenus.accessibility.verbosity": {
          "type": "string",
          "enum": [
            "minimal",
            "normal",
            "verbose"
          ],
          "default": "normal",
          "description": "Control verbosity of accessibility announcements for screen readers. Minimal: Only errors and critical operations. Normal: All operations (default). Verbose: Detailed progress and contextual information.",
          "markdownDescription": "Controls how much information is announced to screen readers during extension operations.\n\n- `minimal` — only errors and critical operations are announced\n- `normal` *(default)* — all operations are announced\n- `verbose` — detailed progress and contextual information is announced\n\n**Example:** Use `\"minimal\"` to reduce screen reader noise during rapid copy/paste workflows.",
          "enumDescriptions": [
            "Only announce errors and critical operations",
            "Announce all operations (recommended)",
            "Announce detailed progress and contextual information"
          ]
        },
        "additionalContextMenus.accessibility.screenReaderMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable enhanced screen reader support with additional announcements and ARIA labels",
          "markdownDescription": "When `true`, enables enhanced screen reader support including additional ARIA labels and more descriptive announcements in Quick Pick dialogs.\n\n**Example:** Enable this setting when using NVDA, JAWS, or VoiceOver for a more accessible experience."
        },
        "additionalContextMenus.accessibility.keyboardNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Enable enhanced keyboard navigation hints in Quick Pick dialogs",
          "markdownDescription": "When `true`, Quick Pick dialogs display keyboard shortcut hints to help navigate options without a mouse.\n\n**Example:** Set to `false` if you prefer a cleaner Quick Pick UI without navigation hints."
        },
        "additionalContextMenus.fileDiscovery.cacheTTL": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "Time-to-live (ms) for the file discovery cache. Set to 0 to disable caching.",
          "markdownDescription": "How long (in milliseconds) discovered file lists are cached before being refreshed.\n\n- Default: `300000` (5 minutes)\n- Set to `0` to disable caching entirely.\n\n**Example:** Set to `60000` for a 1-minute cache in rapidly-changing workspaces."
        }
      }
    },
    "submenus": [
      {
        "id": "additionalContextMenus.submenu",
        "label": "Additional Context Menus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "additionalContextMenus.copyFunction",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.copyFunctionToFile",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.moveFunctionToFile",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.copySelectionToFile",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.moveSelectionToFile",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.generateEnum",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.generateCronTimer",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.copyFileContents",
          "when": "false"
        },
        {
          "command": "additionalContextMenus.duplicateFile",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "additionalContextMenus.submenu",
          "when": "editorTextFocus && additionalContextMenus.enabled",
          "group": "navigation"
        }
      ],
      "additionalContextMenus.submenu": [
        {
          "when": "editorTextFocus && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/",
          "command": "additionalContextMenus.copyFunction",
          "group": "1_function@1"
        },
        {
          "when": "editorTextFocus && additionalContextMenus.enabled && additionalContextMenus.isInFunction && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/",
          "command": "additionalContextMenus.copyFunctionToFile",
          "group": "1_function@2"
        },
        {
          "when": "editorTextFocus && additionalContextMenus.enabled && additionalContextMenus.isInFunction && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/",
          "command": "additionalContextMenus.moveFunctionToFile",
          "group": "1_function@3"
        },
        {
          "when": "editorTextFocus && editorHasSelection && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/",
          "command": "additionalContextMenus.copySelectionToFile",
          "group": "2_selection@1"
        },
        {
          "when": "editorTextFocus && editorHasSelection && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/",
          "command": "additionalContextMenus.moveSelectionToFile",
          "group": "2_selection@2"
        },
        {
          "when": "editorTextFocus && additionalContextMenus.enabled",
          "command": "additionalContextMenus.saveAll",
          "group": "3_workspace@1"
        },
        {
          "when": "editorTextFocus && additionalContextMenus.enabled",
          "command": "additionalContextMenus.openInTerminal",
          "group": "3_workspace@2"
        },
        {
          "when": "editorTextFocus && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx)$/",
          "command": "additionalContextMenus.generateEnum",
          "group": "4_generation@1"
        },
        {
          "when": "editorTextFocus && additionalContextMenus.enabled",
          "command": "additionalContextMenus.generateCronTimer",
          "group": "4_generation@2"
        },
        {
          "when": "editorTextFocus && additionalContextMenus.enabled",
          "command": "additionalContextMenus.generateEnvFile",
          "group": "4_generation@3"
        }
      ],
      "explorer/context": [
        {
          "when": "additionalContextMenus.enabled",
          "command": "additionalContextMenus.renameFileConvention",
          "group": "7_modification@1"
        },
        {
          "when": "additionalContextMenus.enabled && !explorerResourceIsFolder && !listMultiSelection",
          "command": "additionalContextMenus.copyFileContents",
          "group": "6_copypath@2"
        },
        {
          "when": "additionalContextMenus.enabled && !explorerResourceIsFolder && !listMultiSelection",
          "command": "additionalContextMenus.duplicateFile",
          "group": "7_modification@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "additionalContextMenus.copyFunction",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "editorTextFocus && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/"
      },
      {
        "command": "additionalContextMenus.copyFunctionToFile",
        "key": "ctrl+alt+shift+e",
        "mac": "cmd+alt+shift+e",
        "when": "editorTextFocus && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/"
      },
      {
        "command": "additionalContextMenus.copySelectionToFile",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "editorTextFocus && editorHasSelection && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/"
      },
      {
        "command": "additionalContextMenus.moveFunctionToFile",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorTextFocus && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/"
      },
      {
        "command": "additionalContextMenus.moveSelectionToFile",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m",
        "when": "editorTextFocus && editorHasSelection && additionalContextMenus.enabled && resourceExtname =~ /\\.(ts|tsx|js|jsx)$/"
      },
      {
        "command": "additionalContextMenus.saveAll",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a",
        "when": "additionalContextMenus.enabled"
      },
      {
        "command": "additionalContextMenus.openInTerminal",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "editorTextFocus && additionalContextMenus.enabled"
      }
    ]
  },
