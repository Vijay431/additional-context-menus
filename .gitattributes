# Normalise line endings to LF everywhere; Biome and editors expect LF.
* text=auto eol=lf

# Source and config
*.ts text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.init text eol=lf

# Dotfiles and hooks without a useful extension
.husky/* text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.vscodeignore text eol=lf
.all-contributorsrc text eol=lf
.markdownlint-cli2.jsonc text eol=lf
LICENSE text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.vsix binary

# Lockfile: generated, keep out of diffs and language stats
pnpm-lock.yaml -diff linguist-generated
